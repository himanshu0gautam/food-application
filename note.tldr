			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:sGk05sXnJzdcLKC3tIk1E",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 3232.699951171875,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "CI/CD Pipelines"
								},
								{
									"type": "text",
									"text": " ko samajhna kaafi aasaan hai agar hum ise ek \"Automation Robot\" ki tarah dekhein."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Simple shabdon mein: "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "CI/CD ek aisi setting hai jisse aapka code likhne se lekar website par live hone tak ka safar automatic ho jata hai."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Aaiye isse detail mein aur ek simple example ke saath samajhte hain."
								}
							]
						},
						{
							"type": "heading",
							"attrs": {
								"dir": "auto",
								"level": 3
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "1. CI aur CD ka Matlab Kya Hai?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Isse do hisson mein baata (divide) gaya hai:"
								}
							]
						},
						{
							"type": "bulletList",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "CI (Continuous Integration):"
												},
												{
													"type": "text",
													"text": " Iska matlab hai "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "\"Roz code mix karna aur test karna.\""
												},
												{
													"type": "text",
													"text": " Jab multiple developers ek team mein kaam karte hain, toh sab apna-apna code ek jagah (jaise GitHub) par save karte hain. "
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "CI tool turant us code ko check karta hai ki, \"Kya is naye code se purana code toot toh nahi gaya?\""
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "CD (Continuous Delivery/Deployment):"
												},
												{
													"type": "text",
													"text": " Iska matlab hai "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "\"Customer ko turant deliver karna.\""
												},
												{
													"type": "text",
													"text": " Agar code test mein pass ho gaya, toh CD tool usse automatically aapke server (website/app) par upload kar deta hai taaki users naye features use kar sakein."
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						}
					]
				}
			},
