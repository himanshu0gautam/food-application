											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Rate limiting/ throttling ---> Jaise: “ek user 1 minute mein sirf 10 requests kar sakta hai” — to Redis har request ka count rakhta hai aur limit cross hone par block kar deta hai"
												}
											]
