															"type": "bold"
														}
													],
													"text": "Simple API:"
												},
												{
													"type": "text",
													"text": " It uses a straightforward "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "set"
												},
												{
													"type": "text",
													"text": " function to update the state, similar to "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "useState"
												},
												{
													"type": "text",
													"text": ", but it handles merging updates automatically."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Performance:"
												},
												{
													"type": "text",
													"text": " It uses a selector pattern to only re-render components that consume the specific piece of state they need, ensuring good performance"
												}
											]
										}
									]
								}
							]
						},
